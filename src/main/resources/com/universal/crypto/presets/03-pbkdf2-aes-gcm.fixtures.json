    {
      "name": "Repeater second pass does not encrypt ciphertext again",
      "direction": "request",
      "route": "wire",
      "method": "POST",
      "url": "https://api.example.test/api/demo",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"salt\":\"ZXhhbXBsZS1zYWx0LTEyMw==\",\"iv\":\"AAECAwQFBgcICQoL\",\"ciphertext\":\"xI1lwo5i/Znt3BkFqSBOq3bRo937gUxVBQ1PSLJs+jLkPpjF6bPZlRg=\"}",
      "expect": {
        "body": "{\"salt\":\"ZXhhbXBsZS1zYWx0LTEyMw==\",\"iv\":\"AAECAwQFBgcICQoL\",\"ciphertext\":\"xI1lwo5i/Znt3BkFqSBOq3bRo937gUxVBQ1PSLJs+jLkPpjF6bPZlRg=\"}",
        "unchanged": true,
        "success": true
