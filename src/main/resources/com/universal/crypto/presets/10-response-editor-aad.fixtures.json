        "headers": {
          "Content-Length": "36"
        },
        "errors": 0
      }
    },
    {
      "name": "wire must not re-encrypt PCCgeqmQ",
      "direction": "response",
      "route": "wire",
      "method": "POST",
      "url": "https://api.example.test/api/demo",
      "headers": {
        "Content-Type": "application/json",
        "Content-Length": "36"
      },
      "requestHeaders": {
        "X-Nonce": "nonce-one"
      },
      "body": "PCCgeqmQpzm3c+qfG5sRUvhXiy2PukX40CoJ",
      "expect": {
        "body": "PCCgeqmQpzm3c+qfG5sRUvhXiy2PukX40CoJ",
